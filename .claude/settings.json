      "Bash(npm run-script deploy*)",
      "Bash(pnpm run deploy*)",
      "Bash(pnpm deploy*)",
      "Bash(yarn deploy*)",
      "Bash(yarn run deploy*)",

      "Bash(*lockDeploy*)",
      "Bash(*deploys/*lock*)",

      "PowerShell(git push *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git -C * push)",
      "PowerShell(git -C * push *)",
      "PowerShell(git -c * push)",
      "PowerShell(git -c * push *)",
      "PowerShell(git --git-dir=* push)",
      "PowerShell(git --git-dir=* push *)",
      "PowerShell(*git.exe* push)",
      "PowerShell(*git.exe* push *)",

      "PowerShell(git reset --hard *)",
      "PowerShell(git reset * --hard)",
      "PowerShell(git reset * --hard *)",
      "PowerShell(git -C * reset --hard)",
      "PowerShell(git -C * reset --hard *)",

      "PowerShell(netlify* deploy*)",
