      "PowerShell(npx * netlify* deploy*)",
      "PowerShell(npm exec netlify* deploy*)",
      "PowerShell(npm exec * netlify* deploy*)",
      "PowerShell(npm run deploy*)",
      "PowerShell(npm run-script deploy*)",
      "PowerShell(pnpm run deploy*)",
      "PowerShell(pnpm deploy*)",
      "PowerShell(yarn deploy*)",
      "PowerShell(yarn run deploy*)",

      "PowerShell(*lockDeploy*)",
      "PowerShell(*deploys/*lock*)",

      "mcp__claude_ai_Netlify__netlify-deploy-services-updater",
      "mcp__claude_ai_Netlify__netlify-extension-services-updater",
