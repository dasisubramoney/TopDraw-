# REQUIRED. The address the site will be served from, with https:// and no trailing slash.
# Used for the canonical link, social sharing, structured data, sitemap.xml, robots.txt and llms.txt.
# The build FAILS if this is missing or if %VITE_SITE_URL% survives anywhere in dist/.
# Until the real domain is set, this is the temporary Netlify address (CONFIRM it matches the real
# *.netlify.app site name). At go-live, change it to the domain and redeploy.
VITE_SITE_URL=https://topdrawprojects.netlify.app
