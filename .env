# REQUIRED. The address the site will be served from, with https:// and no trailing slash.
# Used for the canonical link, social sharing, structured data, sitemap.xml, robots.txt and llms.txt.
# The build FAILS if this is missing, if it points at a netlify.app address, or if %VITE_SITE_URL%
# survives anywhere in dist/. This is the production domain (bare domain, no www).
VITE_SITE_URL=https://topdrawprojects.co.za
